# Required: your Omi App ID (from the Omi developer dashboard)
OMI_APP_ID=

# Required: a long random string. Used both to sign OAuth state / setup tokens
# AND to derive the AES key that encrypts each user's Poke API key into their
# webhook URL. Rotating it invalidates every issued webhook URL — which is the
# "revoke all" mechanism since this bridge has no database.
# Generate with: openssl rand -hex 32
APP_SECRET=

# Public base URL of this deployment, no trailing slash.
# Locally: http://localhost:3000
# Vercel:  https://your-project.vercel.app
PUBLIC_BASE_URL=

# Optional: shared secret Omi sends in the `Authorization: Bearer ...` header
# of webhook calls. If set, requests without a matching header are rejected.
OMI_WEBHOOK_SECRET=
